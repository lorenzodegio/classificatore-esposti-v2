        "elementi": {
          "items": {
            "$ref": "#/$defs/Voce"
          },
          "title": "Elementi",
          "type": "array"
        },
        "elementi_altro": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elementi Altro"
        },
        "problematica": {
          "items": {
            "$ref": "#/$defs/Voce"
          },
          "title": "Problematica",
          "type": "array"
        },
        "problematica_altro": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problematica Altro"
        }
      },
      "required": [
        "data_doc",
        "comune",
        "ambito",
        "problematica",
        "elementi"
      ],
      "title": "Scheda",
      "type": "object"
    },
    "TemaProposto": {
      "properties": {
        "frase": {
          "maxLength": 300,
          "title": "Frase",
          "type": "string"
        },
        "motivo": {
          "title": "Motivo",
          "type": "string"
        },
        "pagina": {
          "minimum": 1,
          "title": "Pagina",
          "type": "integer"
        },
        "valore": {
          "title": "Valore",
          "type": "string"
        }
      },
      "required": [
        "valore",
        "motivo",
        "frase",
        "pagina"
      ],
      "title": "TemaProposto",
      "type": "object"
    },
    "TipoDocumento": {
      "properties": {
        "motivo": {
          "title": "Motivo",
          "type": "string"
        },
        "valore": {
          "title": "Valore",
          "type": "string"
        }
      },
      "required": [
        "valore",
        "motivo"
      ],
      "title": "TipoDocumento",
      "type": "object"
    },
    "Voce": {
      "properties": {
        "frase": {
          "maxLength": 300,
          "title": "Frase",
          "type": "string"
        },
        "pagina": {
          "minimum": 1,
          "title": "Pagina",
          "type": "integer"
        },
        "valore": {
          "title": "Valore",
          "type": "string"
        }
      },
      "required": [
        "valore",
        "frase",
        "pagina"
      ],
      "title": "Voce",
      "type": "object"
    },
    "VoceData": {
      "properties": {
        "frase": {
          "maxLength": 300,
          "title": "Frase",
          "type": "string"
        },
        "pagina": {
          "minimum": 1,
          "title": "Pagina",
          "type": "integer"
        },
        "valore": {
          "format": "date",
          "title": "Valore",
          "type": "string"
        }
      },
      "required": [
        "valore",
        "frase",
        "pagina"
      ],
      "title": "VoceData",
      "type": "object"
    }
  },
  "properties": {
    "documento": {
      "$ref": "#/$defs/DocumentoRef"
    },
    "lettura_incerta": {
      "title": "Lettura Incerta",
      "type": "boolean"
    },
    "pagine": {
      "items": {
        "$ref": "#/$defs/Pagina"
      },
      "title": "Pagine",
      "type": "array"
    },
    "proposta": {
      "$ref": "#/$defs/Proposta"
    },
    "protocollo": {
      "anyOf": [
        {
          "$ref": "#/$defs/Protocollo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scheda": {
      "$ref": "#/$defs/Scheda"
    },
    "temi": {
      "items": {
        "$ref": "#/$defs/TemaProposto"
      },
      "title": "Temi",
      "type": "array"
    },
    "tipo_documento": {
      "$ref": "#/$defs/TipoDocumento"
    },
    "versione_contratto": {
      "pattern": "^1\\.[0-9]+$",
      "title": "Versione Contratto",
      "type": "string"
    },
    "versione_motore": {
      "title": "Versione Motore",
      "type": "string"
    }
  },
  "required": [
    "versione_contratto",
    "versione_motore",
    "documento",
    "tipo_documento",
    "pagine",
    "lettura_incerta",
    "scheda",
    "proposta",
    "temi"
  ],
  "title": "Risultato",
  "type": "object"
}
