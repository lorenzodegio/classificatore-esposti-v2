{
  "$defs": {
    "DocumentoRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "DocumentoRef",
      "type": "object"
    },
    "Pagina": {
      "properties": {
        "acquisizione": {
          "enum": [
            "testo_nativo",
            "ocr",
            "ocr_manoscritto",
            "nessuna"
          ],
          "title": "Acquisizione",
          "type": "string"
        },
        "lettura_incerta": {
          "title": "Lettura Incerta",
          "type": "boolean"
        },
        "motivo_incertezza": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motivo Incertezza"
        },
        "numero": {
          "minimum": 1,
          "title": "Numero",
          "type": "integer"
        },
        "testo": {
          "title": "Testo",
          "type": "string"
        }
      },
      "required": [
        "numero",
        "acquisizione",
        "testo",
        "lettura_incerta"
      ],
      "title": "Pagina",
      "type": "object"
    },
    "Proposta": {
      "properties": {
        "azione": {
          "items": {
            "type": "string"
          },
          "title": "Azione",
          "type": "array"
        },
        "da_verificare_sull_originale": {
          "items": {
            "type": "string"
          },
          "title": "Da Verificare Sull Originale",
          "type": "array"
        },
        "domanda_decisiva": {
          "title": "Domanda Decisiva",
          "type": "string"
        },
        "esito": {
          "title": "Esito",
          "type": "string"
        },
        "motivo": {
          "title": "Motivo",
          "type": "string"
        },
        "urgenza": {
          "title": "Urgenza",
          "type": "string"
        }
      },
      "required": [
        "esito",
        "urgenza",
        "azione",
        "motivo",
        "domanda_decisiva",
        "da_verificare_sull_originale"
      ],
      "title": "Proposta",
      "type": "object"
    },
    "Protocollo": {
      "properties": {
        "data": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "frase": {
          "maxLength": 300,
          "title": "Frase",
          "type": "string"
        },
        "numero": {
          "title": "Numero",
          "type": "string"
        },
        "pagina": {
          "minimum": 1,
          "title": "Pagina",
          "type": "integer"
        }
      },
      "required": [
        "numero",
        "frase",
        "pagina"
      ],
      "title": "Protocollo",
      "type": "object"
    },
    "Scheda": {
